# 複製本檔為 .env 並依實際環境修改後再執行 run_all.sh
# 這些值都是此測試主機的基礎設施識別資訊，屬於環境專屬設定，
# 不應提交進公開 git repo（.env 已列在 .gitignore）。
#
# 註：SLOG_DEVICE 與部署路徑不需要在這裡設定，程式會自動偵測
# （SLOG_DEVICE 從 `zpool status` 讀取，部署路徑就是本專案所在目錄）。

# ZFS pool 名稱
POOL=nas-zfs-pool

# Proxmox storage ID（底層對應到上面的 ZFS pool，用於動態掃描哪些 VM 用到這顆 iSCSI LUN）
ISCSI_STORAGE_ID=nas-iscsi-zfs

# 絕不觸碰（測試期間絕不停機）的 VM ID 清單，以空白分隔
NEVER_TOUCH_VMS="100 102"
